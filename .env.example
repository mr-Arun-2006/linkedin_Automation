# OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openrouter/free

# GNews
GNEWS_API_KEY=your_gnews_key_here

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=choose_a_long_random_verification_token
WHATSAPP_ADMIN_PHONE=your_admin_whatsapp_number_in_international_format
WHATSAPP_GRAPH_VERSION=v26.0

# Runtime state
WHATSAPP_STATE_DB=data/whatsapp_state.db
