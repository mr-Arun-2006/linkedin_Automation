# OpenRouter
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openrouter/free

# GNews
GNEWS_API_KEY=your_gnews_key_here

# Telegram Bot
# Create the bot with @BotFather and keep this token secret.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Your numeric Telegram user ID. Do not use your username.
TELEGRAM_ADMIN_USER_ID=your_numeric_telegram_user_id
# Used by Telegram when it calls your webhook.
TELEGRAM_WEBHOOK_SECRET=choose_a_long_random_secret

# Runtime state
REMOTE_STATE_DB=data/remote_state.db
